{
    "name": "capell-app/welcome-tour",
    "description": "Configurable Filament onboarding tours and per-user welcome flow for the Capell admin panel.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Capell\\WelcomeTour\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\WelcomeTour\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WelcomeTour\\Providers\\WelcomeTourServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^4.0",
        "jibaymcs/filament-tour": "^5.0",
        "laravel/framework": "^11.44.2|^12.0|^13.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-package-tools": "^1.15",
        "spatie/laravel-settings": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.15|^10.8|^11.0",
        "pestphp/pest": "^3.8|^4.3",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "bin/pest --colors=always"
    },
    "homepage": "https://github.com/capell-app/welcome-tour",
    "keywords": [
        "capell",
        "cms",
        "laravel",
        "filament",
        "onboarding",
        "user-onboarding",
        "product-tour",
        "guided-tour",
        "walkthrough",
        "tooltips",
        "admin-ux",
        "activation",
        "checklist",
        "telemetry"
    ],
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/welcome-tour"
    }
}
